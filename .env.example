# Copy to .env and change ALL passwords before first start.
# Never commit .env to git.

# --- Postgres ---
POSTGRES_USER=shared
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=shared
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# --- RabbitMQ ---
RABBITMQ_USER=shared
RABBITMQ_PASSWORD=CHANGE_ME_strong_rabbit_password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_BIND=127.0.0.1
RABBITMQ_MGMT_BIND=127.0.0.1
